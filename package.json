{
  "name": "dsh-plugin-voice-local",
  "version": "0.9.9",
  "description": "Local full-duplex voice for DeepSeek Harness: resident ONNX TTS + sherpa-onnx ASR inside the host (worker_threads), taps llm/stream to read replies aloud, exposes loopback-only routes and an SSE channel. No Python process, no extra ports, no cloud speech APIs.",
  "author": "god1sdfghjkl",
  "homepage": "https://github.com/god1sdfghjkl/dsh-plugin-voice-local#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/god1sdfghjkl/dsh-plugin-voice-local.git"
  },
  "bugs": {
    "url": "https://github.com/god1sdfghjkl/dsh-plugin-voice-local/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "examples",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0 <0.3.0-0"
  },
  "scripts": {
    "test": "node test/parity.mjs && node test/models-smoke.mjs && node test/downloader-smoke.mjs && node test/voiceprint-smoke.mjs && node test/breeze-smoke.mjs && node test/tts-api-smoke.mjs && node test/dsh-asr-smoke.mjs && node test/call-persona-smoke.mjs && node test/dshgo-smoke.mjs && node test/client-smoke.mjs && node test/asr-smoke.mjs && node test/host-smoke.mjs",
    "test:ci": "node test/parity.mjs && node test/models-smoke.mjs && node test/downloader-smoke.mjs && node test/breeze-smoke.mjs && node test/tts-api-smoke.mjs && node test/dsh-asr-smoke.mjs && node test/call-persona-smoke.mjs && node test/dshgo-smoke.mjs && node test/client-smoke.mjs",
    "test:parity": "node test/parity.mjs",
    "test:models": "node test/models-smoke.mjs",
    "test:download": "node test/downloader-smoke.mjs",
    "test:client": "node test/client-smoke.mjs",
    "test:asr": "node test/asr-smoke.mjs",
    "test:voiceprint": "node test/voiceprint-smoke.mjs",
    "test:host": "node test/host-smoke.mjs",
    "models:manifest": "node scripts/model-manifest.mjs",
    "test:persona": "node test/call-persona-smoke.mjs",
    "test:dshgo": "node test/dshgo-smoke.mjs",
    "test:breeze": "node test/breeze-smoke.mjs",
    "test:api": "node test/tts-api-smoke.mjs",
    "test:dsh-asr": "node test/dsh-asr-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "tts",
    "asr",
    "barge-in",
    "local",
    "on-device"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.0",
    "title": {
      "zh": "本地朗读",
      "en": "Local Voice"
    },
    "icon": "speaker",
    "wants": [
      "message"
    ],
    "capabilities": [
      "audio",
      "voice"
    ],
    "contributes": {
      "message.actions": [
        {
          "id": "read",
          "label": "朗读",
          "icon": "speaker",
          "requires": [
            "audio"
          ]
        }
      ],
      "media": [
        {
          "id": "speech"
        }
      ]
    }
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.4",
    "onnxruntime-node": "1.31.1",
    "sherpa-onnx": "^2.0.1"
  }
}
